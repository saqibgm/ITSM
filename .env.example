# App
APP_ENV=development
SECRET_KEY=change-me-to-a-random-32-byte-hex-string
ALLOWED_ORIGINS=http://localhost:3000

# Database
# DATABASE_URL dev:  postgresql+asyncpg://itsm_user:itsm_pass@localhost:5432/itsm_db
# DATABASE_URL prod: postgresql+asyncpg://itsm_user:<pass>@shared-pg-host:5432/itsm_db
DATABASE_URL=postgresql+asyncpg://itsm_user:itsm_pass@localhost:5432/itsm_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_STATEMENT_TIMEOUT_SECONDS=30

# Redis
REDIS_URL=redis://localhost:6379/0

# IAM (OIDC Resource Server — ITSM validates JWTs only, never stores credentials)
IAM_BASE_URL=https://api.dev.iam.99technologies.com
IAM_CLIENT_ID=your-itsm-app-client-id
IAM_CLIENT_SECRET=your-itsm-app-client-secret
IAM_JWKS_URL=https://api.dev.iam.99technologies.com/.well-known/jwks.json
IAM_WEBHOOK_SECRET=your-hmac-webhook-secret
PLATFORM_ORG_ID=org_99technologies_placeholder

# Storage (S3-compatible — MinIO for dev, AWS S3 for prod)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=itsm-files
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PRESIGN_EXPIRY_SECONDS=3600

# Email
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=ITSM Support

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=2048
CLAUDE_TIMEOUT_SECONDS=30

# OpenAI (Embeddings)
OPENAI_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# AI Cost Controls
AI_DEFAULT_MONTHLY_TOKEN_BUDGET=5000000
AI_DUPLICATE_THRESHOLD=0.85
AI_MAINTENANCE_BATCH_SIZE=50

# Observability (leave empty to disable)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
